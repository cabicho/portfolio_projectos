#!/usr/bin/env python3

import pandas as pd
import os
import logging
from sqlalchemy import create_engine, text

logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')
logger = logging.getLogger(__name__)

class SalesDataMart:
    def __init__(self, db_url):
        self.engine = create_engine(db_url)
        self.schema = "sales_mart"
        
    def create_schema(self):
        """Cria schema do data mart"""
        with self.engine.begin() as conn:
            conn.execute(text(f"CREATE SCHEMA IF NOT EXISTS {self.schema}"))
        logger.info(f"✅ Schema {self.schema} criado/verificado")
    
    def create_dimensions(self):
        """Cria tabelas dimensionais"""
        dimensions_sql = [
            f"""
            CREATE TABLE IF NOT EXISTS {self.schema}.dim_customer (
                customer_key SERIAL PRIMARY KEY,
                customer_id INTEGER,
                customer_name VARCHAR(100),
                segment VARCHAR(50),
                region VARCHAR(50),
                country VARCHAR(50),
                effective_date DATE,
                is_current BOOLEAN DEFAULT true
            );
            """,
            f"""
            CREATE TABLE IF NOT EXISTS {self.schema}.dim_product (
                product_key SERIAL PRIMARY KEY,
                product_id INTEGER,
                product_name VARCHAR(100),
                category VARCHAR(50),
                sub_category VARCHAR(50),
                price DECIMAL(10,2),
                cost DECIMAL(10,2),
                profit_margin DECIMAL(5,4),
                effective_date DATE,
                is_current BOOLEAN DEFAULT true
            );
            """,
            f"""
            CREATE TABLE IF NOT EXISTS {self.schema}.dim_date (
                date_key SERIAL PRIMARY KEY,
                full_date DATE,
                day INTEGER,
                month INTEGER,
                quarter INTEGER,
                year INTEGER,
                day_of_week INTEGER,
                is_weekend BOOLEAN
            );
            """
        ]
        
        with self.engine.begin() as conn:
            for sql in dimensions_sql:
                conn.execute(text(sql))
        
        logger.info("✅ Tabelas dimensionais criadas")
    
    def create_fact_table(self):
        """Cria tabela fatual"""
        fact_sales_sql = f"""
        CREATE TABLE IF NOT EXISTS {self.schema}.fact_sales (
            sale_key SERIAL PRIMARY KEY,
            date_key INTEGER,
            customer_key INTEGER,
            product_key INTEGER,
            quantity INTEGER,
            amount DECIMAL(10,2),
            total_amount DECIMAL(10,2),
            profit_amount DECIMAL(10,2),
            FOREIGN KEY (date_key) REFERENCES {self.schema}.dim_date(date_key),
            FOREIGN KEY (customer_key) REFERENCES {self.schema}.dim_customer(customer_key),
            FOREIGN KEY (product_key) REFERENCES {self.schema}.dim_product(product_key)
        );
        """
        
        with self.engine.begin() as conn:
            conn.execute(text(fact_sales_sql))
        
        logger.info("✅ Tabela fatual criada")
    
    def populate_date_dimension(self):
        #"""Popula dimensão de data"""
        
        # Gerar datas para os últimos 2 anos
        dates = pd.date_range(start='2022-01-01', end='2024-12-31', freq='D')
        
        dim_date_data = pd.DataFrame({
            'full_date': dates,
            'day': dates.day,
            'month': dates.month,
            'quarter': dates.quarter,
            'year': dates.year,
            'day_of_week': dates.dayofweek + 1,  # 1-7 (Monday-Sunday)
            'is_weekend': dates.dayofweek.isin([5, 6])  # Saturday, Sunday
        })
        
        try:
            # CORREÇÃO: Usar if_exists='append' em vez de 'replace'
            # Primeiro verificar se a tabela já tem dados
            with self.engine.connect() as conn:
                result = conn.execute(text(f"SELECT COUNT(*) FROM {self.schema}.dim_date"))
                count = result.scalar()
                
                if count == 0:
                    # Tabela vazia, podemos fazer replace
                    dim_date_data.to_sql(
                        'dim_date', 
                        self.engine, 
                        schema=self.schema, 
                        if_exists='replace', 
                        index=False
                    )
                    logger.info(f"✅ Dimensão de data populada: {len(dim_date_data)} registros")
                else:
                    logger.info(f"✅ Dimensão de data já contém {count} registros")
                    
        except Exception as e:
            logger.warning(f"⚠️  Erro ao verificar/popular dim_date: {e}")
            logger.info("🔄 Tentando abordagem alternativa...")
            
            # Abordagem alternativa: usar INSERT manual
            try:
                with self.engine.begin() as conn:
                    # Limpar dados existentes
                    conn.execute(text(f"TRUNCATE TABLE {self.schema}.dim_date RESTART IDENTITY"))
                    
                    # Inserir novos dados
                    for _, row in dim_date_data.iterrows():
                        conn.execute(text(f"""
                            INSERT INTO {self.schema}.dim_date 
                            (full_date, day, month, quarter, year, day_of_week, is_weekend)
                            VALUES (:date, :day, :month, :quarter, :year, :dow, :weekend)
                        """), {
                            'date': row['full_date'],
                            'day': row['day'],
                            'month': row['month'], 
                            'quarter': row['quarter'],
                            'year': row['year'],
                            'dow': row['day_of_week'],
                            'weekend': row['is_weekend']
                        })
                        
                logger.info(f"✅ Dimensão de data populada (método alternativo): {len(dim_date_data)} registros")
                
            except Exception as e2:
                logger.error(f"❌ Falha ao popular dimensão de data: {e2}")
                raise

    def build_complete_mart(self):
        """Constrói o data mart completo"""
        try:
            logger.info("🏗️  Construindo Sales Data Mart...")
            self.create_schema()
            self.create_dimensions()
            self.create_fact_table()
            self.populate_date_dimension()
            logger.info("✅ Sales Data Mart construído com sucesso!")
        except Exception as e:
            logger.error(f"❌ Erro na construção do data mart: {e}")
            raise

if __name__ == "__main__":
    db_url = f"postgresql://{os.getenv('DB_USER')}:{os.getenv('DB_PASSWORD')}@{os.getenv('DB_HOST')}:{os.getenv('DB_PORT')}/{os.getenv('DB_NAME')}"
    data_mart = SalesDataMart(db_url)
    data_mart.build_complete_mart()
